# Entry point. Always run Snakemake from the repository root (`pixi run workflow`):
# `configfile:` and all pathvars are resolved relative to the working directory.
from snakemake.utils import min_version

min_version("9.19")


configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/load_and_filter.smk"
include: "rules/dada2.smk"


if config["notify"]["telegram"]:

    include: "rules/notify.smk"


rule all:
    input:
        reports_trim=expand("<reports>/qc/filterAndTrim/report_{sample}.tsv", sample=SAMPLES.index),
        ps_raw="<temp>/ps_raw.rds",


rule AssignBatches:
    input:
        config["samples_no_batch"],
    output:
        config["samples"],
    run:
        import pandas as pd
        from random import shuffle

        samples = pd.read_csv(input[0], index_col=config["samples_index_col"], sep="\t")
        BATCH_SIZE = config["batch_size"]
        if len(samples.index) % BATCH_SIZE < BATCH_SIZE * 0.7:
            last_batch_size = len(samples) % BATCH_SIZE
            extra_samples_to_batch = last_batch_size // (len(samples) // BATCH_SIZE) + 1
            BATCH_SIZE += extra_samples_to_batch
            print(f"Adjusted batch size to {BATCH_SIZE} to avoid small last batch (less then 70% of batch size)")
        batches = [f"B{i // BATCH_SIZE+1}" for i in range(len(samples))]
        shuffle(batches)
        samples["batch"] = batches
        samples.to_csv(output[0], sep="\t")
